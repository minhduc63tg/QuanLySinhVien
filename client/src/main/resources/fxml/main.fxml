<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sms.client.controller.MainController">
    <left>
        <VBox styleClass="sidebar">
            <Label fx:id="tenNguoiDungLabel" styleClass="user-name" wrapText="true"/>
            <Label fx:id="vaiTroLabel"/>
            <Separator/>
            <VBox fx:id="menuBox" spacing="4" VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Button text="Đổi mật khẩu" onAction="#onDoiMatKhau"/>
            <Button fx:id="dangXuatButton" text="Đăng xuất" onAction="#onDangXuat"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="noiDung">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>
        </StackPane>
    </center>
</BorderPane>
