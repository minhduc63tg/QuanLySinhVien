<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="smsPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.sms.server.entity.TaiKhoan</class>
        <class>com.sms.server.entity.Khoa</class>
        <class>com.sms.server.entity.LopHoc</class>
        <class>com.sms.server.entity.SinhVien</class>
        <class>com.sms.server.entity.GiangVien</class>
        <class>com.sms.server.entity.MonHoc</class>
        <class>com.sms.server.entity.LopHocPhan</class>
        <class>com.sms.server.entity.LichHoc</class>
        <class>com.sms.server.entity.DangKyHocPhan</class>
        <class>com.sms.server.entity.ChuongTrinhKhung</class>
        <class>com.sms.server.entity.ChuongTrinhKhungMon</class>
        <class>com.sms.server.entity.LichThi</class>
        <class>com.sms.server.entity.AnhHoSo</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.hbm2ddl.halt_on_error" value="true"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MariaDBDialect"/>
            <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.connectionTimeout" value="10000"/>
            <property name="hibernate.hikari.connectionInitSql" value="SET NAMES utf8mb4"/>
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>
